(defvar php-ide-feature-alist '((none :test (lambda nil t) :activate (lambda nil t) :deactivate (lambda nil t)) (phpactor :test (lambda nil (and (require 'phpactor nil t) (require 'php-ide-phpactor nil t) (featurep 'phpactor))) :activate php-ide-phpactor-activate :deactivate php-ide-phpactor-deactivate) (eglot :test (lambda nil (and (require 'eglot nil t) (featurep 'eglot))) :activate php-ide-eglot-activate :deactivate php-ide-eglot-deactivate :exclusive lsp-client) (lsp-bridge :test (lambda nil (and (require 'lsp-bridge nil t) (featurep 'lsp-bridge))) :activate (lambda nil (lsp-bridge-mode 1)) :deactivate (lambda nil (lsp-bridge-mode -1)) :exclusive lsp-client) (lsp-mode :test (lambda nil (and (require 'lsp nil t) (featurep 'lsp))) :activate lsp :deactivate lsp-disconnect :exclusive lsp-client)) "\
Alist of PHP-IDE features and how to probe and (de)activate each one.

Each element is (FEATURE . PLIST), where PLIST holds these keywords,
each bound to a function called with no arguments:

`:test'        Return non-nil when FEATURE is usable in this Emacs,
               loading its backing package if necessary.
`:activate'    Turn FEATURE on in the current buffer.
`:deactivate'  Turn FEATURE off in the current buffer.

`:exclusive'   Optional tag.  `php-ide-mode' warns when it is asked to
               activate more than one feature sharing a tag, since they
               would fight over the same buffer.")
(put 'php-ide-feature-alist 'risky-local-variable t)
